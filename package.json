{
  "name": "koinky-kit",
  "version": "0.1.1",
  "description": "Issue soulbound records on the Koinos blockchain with one issuer key: programs, stamps, redemptions, batching, and rebuild-from-chain. Feeless for the holder, no wallet needed.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": "./contract/abi/koinky.abi",
    "./package.json": "./package.json"
  },
  "bin": {
    "koinky-kit": "./bin/koinky-kit.mjs"
  },
  "files": [
    "dist",
    "bin",
    "contract/abi",
    "contract/build/release/contract.wasm",
    "contract/assembly",
    "contract/scripts",
    "contract/asconfig.json",
    "contract/as-pect.config.js",
    "contract/as-pect.asconfig.json",
    "contract/package.json",
    "contract/koinos",
    "contract/google",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "npm run build && node --test --experimental-strip-types tests/*.test.ts",
    "contract:build": "cd contract && sh scripts/build.sh release 0",
    "contract:test": "cd contract && sh scripts/test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "koilib": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Justyoureverydaynormalguybob/koinky-kit"
  },
  "keywords": [
    "koinos",
    "blockchain",
    "soulbound",
    "loyalty",
    "attendance",
    "credentials",
    "feeless"
  ]
}
